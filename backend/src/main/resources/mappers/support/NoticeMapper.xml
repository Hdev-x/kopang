<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kopang.app.domain.support.notice.NoticeMapper">

    <select id="findAll"
        resultType="com.kopang.app.domain.support.notice.NoticeDTO"> 
        SELECT 
            notice_id AS id, 
            title,
            content, 
            created_at AS createdAt 
        FROM notices 
        ORDER BY created_at DESC
    </select>

    <select id="findById"
        resultType="com.kopang.app.domain.support.notice.NoticeDTO"> 
        SELECT 
            notice_id AS id, 
            title,
            content, 
            created_at AS createdAt 
        FROM notices 
        WHERE notice_id = #{id} 
    </select>


</mapper>