<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kopang.app.domain.support.Faq.FaqMapper">
    <select id="findAll"
        resultType="com.kopang.app.domain.support.Faq.FaqDTO">
        SELECT
            faq_id AS id,
            question,
            answer
        FROM faqs
        ORDER BY faq_id ASC
    </select>
</mapper>
