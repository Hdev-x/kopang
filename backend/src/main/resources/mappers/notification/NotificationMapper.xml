<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kopang.app.domain.notification.NotificationMapper">

    <!-- 알림 생성 (이탈 대응 발송 시 호출) -->
    <!-- ref_id는 nullable — 클릭 이동 대상(상품·쿠폰 id) 있을 때만 세팅 -->
    <insert id="insertNotification">
        INSERT INTO notifications
        (
            user_id,
            type,
            message,
            ref_id
        )
        VALUES
        (
            #{userId},
            #{type},
            #{message},
            #{refId}
        )
    </insert>

    <!-- 내 알림 목록 (최신순) -->
    <select id="findByUserId" resultType="com.kopang.app.domain.notification.NotificationDTO">
        SELECT
            notification_id,
            user_id,
            type,
            message,
            ref_id,
            is_read,
            clicked,
            created_at
        FROM notifications
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

</mapper>
