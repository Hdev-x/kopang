<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kopang.app.domain.churn.ChurnMapper">

    <!-- ============================================= -->
    <!-- 조회 : 룰별 이탈 위험 대상 회원                      -->
    <!-- ============================================= -->

    <!-- 룰2) 멤버십 해지한 회원의 user_id 목록 -->
    <select id="findMembershipCancelUsers" resultType="long">
        SELECT user_id
        FROM user_membership
        WHERE status = 'CANCELLED'
        GROUP BY user_id
    </select>

    <!-- 룰3) 첫 주문 이후 30일 넘게 주문이 없는 회원의 user_id 목록 -->
    <select id="findFirstOrderOnlyUsers" resultType="long">
        SELECT user_id
        FROM orders
        GROUP BY user_id
        HAVING COUNT(*) = 1
            AND MAX(ordered_at) &lt; NOW() - INTERVAL '30 days'
    </select>

    <!-- 룰5) 미사용 쿠폰이 3일 내 만료되는 회원의 user_id 목록 -->
    <select id="findCouponExpiringUsers" resultType="long">
        SELECT user_id
        FROM user_coupons
        WHERE used = false
            AND expires_at &gt;= CURRENT_DATE
            AND expires_at &lt;= CURRENT_DATE + INTERVAL '3 days'
        GROUP BY user_id
    </select>

    <!-- 룰7) 30일 넘게 미로그인 회원의 user_id 목록 -->
    <select id="findLoginInactiveUsers" resultType="long">
        SELECT user_id
        FROM users
        WHERE last_login_at &lt; NOW() - INTERVAL '30 days'
            AND status = 'ACTIVE'
            AND role = 'ROLE_USER'
    </select>


    <!-- ============================================= -->
    <!-- 저장 : 판정 결과 (모든 룰 공통)                     -->
    <!-- ============================================= -->

    <!-- 이탈 판정 결과 1건을 churn_score에 저장 -->
    <insert id="insertChurnScore">
        INSERT INTO churn_score 
        (
            user_id, 
            score, 
            risk_level, 
            risk_type, 
            source
        )
        VALUES 
        (
            #{userId}, 
            #{score}, 
            #{riskLevel}, 
            #{riskType}, 
            #{source}
        )
    </insert>


</mapper>